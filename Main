-- 5. ENVIRONMENT LOGIC

-- [[ OVERHEAD KILL VOLUME TEST ]]
-- Cylindrical/column test around a candidate bot-root position: same
-- geometry the comments above describe (flat reach + vertical head span),
-- factored out so it can be evaluated at more than one sample point per
-- frame (see the sweep in the Heartbeat kill check below).
local function pointInKillVolume(samplePos, targetPos)
    local vec = targetPos - samplePos
    local flat = (vec * Vector3.new(1, 0, 1)).Magnitude
    local yDiff = vec.Y
    if vec.Magnitude < CONFIG.KILL_DIST then return true end
    return flat < CONFIG.KILL_FLAT_DIST
        and yDiff > CONFIG.KILL_BELOW_SPAN
        and yDiff < CONFIG.KILL_HEAD_SPAN
end

-- Sweeps the kill-volume test across every sample point between the bot's
-- previous root position and its current one. This is what stops a
-- fast-moving (or lag-spiking) bot from tunneling straight over a player
-- without ever satisfying the check at either frame's exact instant - the
-- classic "goes under/over me" complaint. Bounded by KILL_SWEEP_MAX_DIST so
-- a teleport/respawn can't be abused into a long-range kill.
local function sweepKillVolume(prevPos, currPos, targetPos)
    if pointInKillVolume(currPos, targetPos) then return true end

    local seg = currPos - prevPos
    local segDist = seg.Magnitude
    if segDist < 0.05 or segDist > CONFIG.KILL_SWEEP_MAX_DIST then return false end

    local samples = math.max(1, CONFIG.KILL_SWEEP_SAMPLES)
    for i = 1, samples - 1 do
        local a = i / samples
        if pointInKillVolume(prevPos + seg * a, targetPos) then
            return true
        end
    end
    return false
end

local function hasClearLineOfSight(startPos, endPos, ignoreList)
    RAY_PARAMS.FilterDescendantsInstances = ignoreList
    local dir = endPos - startPos
    local dist = dir.Magnitude
    if dist > 250 then return false end 
    
    if math.abs(startPos.Y - endPos.Y) > 8 then return false end

    if workspace:Raycast(startPos, dir, RAY_PARAMS) then return false end
    
    local cframe = CFrame.lookAt(startPos, endPos)
    local right = cframe.RightVector * CONFIG.LOS_CORRIDOR_HALF 
    
    if workspace:Raycast(startPos + right, dir, RAY_PARAMS) then return false end
    if workspace:Raycast(startPos - right, dir, RAY_PARAMS) then return false end

    return true
end

local function optimizePath(currentIdx, waypoints, botPos, ignoreList)
    local n = #waypoints
    if currentIdx >= n then return n end

    local budget = CONFIG.STRING_PULL_BUDGET

    local function visibleAt(i)
        if budget <= 0 then return false end
        local wp = waypoints[i]
        if not wp then return false end
        if math.abs(wp.Position.Y - botPos.Y) > CONFIG.PULL_Y_TOLERANCE then return false end
        budget -= 1
        return hasClearLineOfSight(botPos, wp.Position, ignoreList)
    end

    local bestIdx = currentIdx
    local probe = currentIdx
    local step = 2

    while probe < n do
        local nextProbe = math.min(probe + step, n)
        if visibleAt(nextProbe) then
            bestIdx = nextProbe
            probe = nextProbe
            if nextProbe == n then break end
            step = step * 2
        else
            local lo, hi = probe, nextProbe
            while hi - lo > 1 and budget > 0 do
                local mid = math.floor((lo + hi) / 2)
                if visibleAt(mid) then
                    lo = mid
                else
                    hi = mid
                end
            end
            bestIdx = math.max(bestIdx, lo)
            break
        end
    end

    return math.max(bestIdx, currentIdx)
end

local function steerAroundObstacle(botPos, aimPos, ignoreList, steerState)
    RAY_PARAMS.FilterDescendantsInstances = ignoreList

    local flatAim = Vector3.new(aimPos.X, botPos.Y, aimPos.Z)
    local toAim = flatAim - botPos
    local distToAim = toAim.Magnitude
    if distToAim < CONFIG.STEER_MIN_AIM_DIST then
        if steerState then steerState.active = false end
        return aimPos
    end

    local dir = toAim.Unit
    local probeDist = math.min(distToAim, CONFIG.STEER_PROBE_DIST)
    local hit = workspace:Raycast(botPos + Vector3.new(0, 1, 0), dir * probeDist, RAY_PARAMS)
    if not hit then
        if steerState then steerState.active = false end
        return aimPos
    end

    local highRay = workspace:Raycast(botPos + Vector3.new(0, 5, 0), dir * probeDist, RAY_PARAMS)
    if not highRay then
        if steerState then steerState.active = false end
        return aimPos
    end

    local n = hit.Normal * Vector3.new(1, 0, 1)
    if n.Magnitude < 0.15 then
        if steerState then steerState.active = false end
        return aimPos
    end
    n = n.Unit

    local tangent = dir - dir:Dot(n) * n
    if tangent.Magnitude < 0.15 then
        tangent = Vector3.new(-n.Z, 0, n.X)
    else
        tangent = tangent.Unit
    end

    -- [[ HYSTERESIS ]] Once a slide side has been committed, keep using it
    -- (still measured against the freshly-hit wall normal) until the commit
    -- window expires or the natural tangent has clearly reversed. Without
    -- this, small frame-to-frame changes in the aim direction flip which
    -- side of the obstacle the detour offsets toward, which reads as
    -- left-right shake while sliding along a wall.
    local now = tick()
    if steerState and steerState.active and steerState.tangent and now < steerState.untilT then
        local agree = tangent:Dot(steerState.tangent)
        if agree >= CONFIG.STEER_TANGENT_REVERSE_DOT then
            tangent = (agree < 0) and -steerState.tangent or steerState.tangent
        end
    end

    if steerState then
        steerState.active = true
        steerState.tangent = tangent
        steerState.untilT = now + CONFIG.STEER_COMMIT_TIME
    end

    local steer = hit.Position + n * CONFIG.STEER_WALL_GAP + tangent * CONFIG.STEER_SLIDE_OFFSET
    return Vector3.new(steer.X, hit.Position.Y, steer.Z)
end

local function analyseTerrainAndObstacles(botRoot, ignoreList)
    local rayDown = RaycastParams.new(); rayDown.FilterDescendantsInstances = ignoreList; rayDown.FilterType = Enum.RaycastFilterType.Exclude
    local floorHit = workspace:Raycast(botRoot.Position, Vector3.new(0, -5, 0), rayDown)
    
    local multiplier = 1
    if floorHit then
        local mat = floorHit.Material
        if CONFIG.SPEED_BOOST_MATS[mat] then multiplier = CONFIG.SPEED_BOOST_MATS[mat] end
        if CONFIG.SPEED_SLOW_MATS[mat] then multiplier = CONFIG.SPEED_SLOW_MATS[mat] end
    end

    local lookDir = botRoot.CFrame.LookVector * 4.5
    local wallHit = workspace:Raycast(botRoot.Position, lookDir, rayDown)
    
    if wallHit and wallHit.Instance and not wallHit.Instance.Anchored and wallHit.Instance.CanCollide then
        wallHit.Instance:ApplyImpulse(lookDir * 4000 + Vector3.new(0, 1500, 0))
    end

    return multiplier
end

local function snapToGround(pos, ignoreList)
    local snapRay = RaycastParams.new()
    snapRay.FilterType = Enum.RaycastFilterType.Exclude
    snapRay.FilterDescendantsInstances = ignoreList
    snapRay.IgnoreWater = true
    local hit = workspace:Raycast(pos + Vector3.new(0, 2, 0), Vector3.new(0, -80, 0), snapRay)
    if hit then
        return hit.Position + Vector3.new(0, 3, 0)
    end
    return pos
end

local function buildPathCosts()
    local costs = { Water = 20, DangerDetector = 99999, Door = 1 }
    for mat, mult in pairs(CONFIG.SPEED_SLOW_MATS) do
        costs[mat.Name] = math.clamp(1 / mult, 1.05, 8)
    end
    for mat, mult in pairs(CONFIG.SPEED_BOOST_MATS) do
        costs[mat.Name] = math.clamp(1 / mult, 0.4, 0.95)
    end
    return costs
end

local function findEscapeDirection(botPos, toPlayerFlat, ignoreList)
    RAY_PARAMS.FilterDescendantsInstances = ignoreList
    local bestDir = toPlayerFlat
    local bestScore = -1

    for angle = 0, 315, 45 do
        local rad = math.rad(angle)
        local dir = Vector3.new(math.cos(rad), 0, math.sin(rad))
        local hit = workspace:Raycast(botPos + Vector3.new(0, 1, 0), dir * CONFIG.ESCAPE_SCAN_DIST, RAY_PARAMS)
        local clearance = hit and (hit.Position - botPos).Magnitude or CONFIG.ESCAPE_SCAN_DIST
        local score = clearance * (0.55 + 0.45 * math.max(0, dir:Dot(toPlayerFlat)))
        if score > bestScore then
            bestScore = score
            bestDir = dir
        end
    end

    return bestDir
end

-- 6. MAIN AI LOOP
task.spawn(function()
    task.wait(1) 
    
    local player = Players:GetPlayers()[1] or Players.PlayerAdded:Wait()
    if not player.Character then player.CharacterAdded:Wait() end
    local targetRoot = player.Character:WaitForChild("HumanoidRootPart")
    
    local startPos = targetRoot.Position + Vector3.new(CONFIG.SPAWN_DIST, 5, 0)
    local bot, botRoot, botHum, botAlign, botImg, botHead, clickDetector = createNextbot(startPos)
    print("GENIUS BOT V25.0 ONLINE - OVERHEAD KILL VOLUME + TRUE LANDING PREDICTION")

    local freezeBtn, spectateBtn = createControlGui(player)
    
    local function toggleFreeze()
        IS_FROZEN = not IS_FROZEN
        if IS_FROZEN then
            freezeBtn.Text = "UNFREEZE BOT"
            freezeBtn.BackgroundColor3 = Color3.new(0.8, 0, 0)
        else
            freezeBtn.Text = "FREEZE BOT"
            freezeBtn.BackgroundColor3 = Color3.new(0, 0.4, 0.8)
        end
    end
    
    local function toggleSpectate()
        IS_SPECTATING = not IS_SPECTATING
        local cam = workspace.CurrentCamera
        if IS_SPECTATING then
            spectateBtn.Text = "STOP SPECTATING"
            spectateBtn.BackgroundColor3 = Color3.new(0.8, 0, 0)
            cam.CameraSubject = botHum
        else
            spectateBtn.Text = "SPECTATE BOT"
            spectateBtn.BackgroundColor3 = Color3.new(0.5, 0, 0.8)
            if player.Character and player.Character:FindFirstChild("Humanoid") then
                cam.CameraSubject = player.Character.Humanoid
            end
        end
    end

    freezeBtn.MouseButton1Click:Connect(toggleFreeze)
    spectateBtn.MouseButton1Click:Connect(toggleSpectate)
    clickDetector.MouseClick:Connect(function(clickPlayer)
        if clickPlayer == player then
            toggleFreeze()
        end
    end)
    
    player.CharacterAdded:Connect(function(newChar)
        task.wait(0.5)
        local newRoot = newChar:WaitForChild("HumanoidRootPart", 5)
        if newRoot then
            targetRoot = newRoot
            resetJukeMemory()
            mlResetEpisodeState()
            JumpState.lastJump = 0
            Nav.active = nil
            Nav.pending = nil
            Nav.firstBuildDone = false
            Nav.verifyCursor = 1
        end
    end)
    
    Players.PlayerRemoving:Connect(function(leavingPlayer)
        if leavingPlayer == player then
            local newPlayers = Players:GetPlayers()
            for _, p in ipairs(newPlayers) do
                if p ~= leavingPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    player = p
                    targetRoot = p.Character.HumanoidRootPart
                    createControlGui(player)
                    Nav.active = nil
                    Nav.pending = nil
                    Nav.firstBuildDone = false
                    return
                end
            end
        end
    end)

    -- Roblox fallback state
    local waypoints = {}
    local currentPointIndex = 2
    local lastPathTime = 0
    local lastTargetPos = targetRoot.Position
    local lastPathAim = nil
    local isComputing = false
    local forceRepath = false
    local pathSource = nil
    
    -- Flow field state
    local fieldGoalKey, fieldBotKey = nil, nil
    local fieldLastCompute, fieldBlackoutUntil = 0, 0
    
    -- Pocket ambush state
    local pocketTimer = 0
    local ambushSuppressUntil = 0
    local ambush = { target = nil, cellIdx = nil, firstSeen = 0, untilT = 0 }
    
    -- Heat decay
    local heatDecayTimer = 0
    
    local lastStuckCheck = tick()
    local lastStuckPos = botRoot.Position
    local stuckCount = 0
    local turnBrakeCooldown = 0

    -- Flow-field local-target hysteresis (see fieldSteer) - shared by the
    -- normal chase steering and the pocket-ambush steering since only one
    -- of them ever drives movement at a time.
    local fieldSteerState = { idx = nil, untilT = 0 }

    -- Wall-slide detour hysteresis (see steerAroundObstacle)
    local wallSteerState = { active = false, tangent = nil, untilT = 0 }

    -- Smooth-facing state: current facing angle (radians, world Y-up yaw)
    -- turned toward the target at a clamped rate instead of snapping.
    local faceYaw = math.atan2(botRoot.CFrame.LookVector.X, botRoot.CFrame.LookVector.Z)

    -- Previous-frame bot position, used to sweep the kill-volume check so a
    -- fast-moving bot can't "step over" a player within a single Heartbeat.
    local lastKillSweepPos = botRoot.Position

    -- Guard-hold hysteresis: once parked on the landing zone, require a
    -- bigger drift-out before resuming steering (stops edge-of-radius flicker)
    local guardHoldActive = false

    local path = PathfindingService:CreatePath({
        AgentRadius = 2.0, 
        AgentHeight = 6.0, 
        AgentCanJump = true,
        AgentCanClimb = true,
        WaypointSpacing = CONFIG.WAYPOINT_SPACING, 
        Costs = buildPathCosts()
    })

    path.Blocked:Connect(function(blockedWaypointIdx)
        if pathSource == "roblox" and waypoints and blockedWaypointIdx >= currentPointIndex then 
            forceRepath = true 
        end
    end)
    
    local function fieldUsableNow(grid, bcx, bcz)
        if not grid or not grid.dist or not grid.distStamp or not grid.fieldCompute then return false end
        local bIdx = navIdx(grid, bcx, bcz)
        if not bIdx then return false end
        return grid.distStamp[bIdx] == grid.fieldCompute
    end
    
    local function ensureField(grid, bcx, bcz, aimPos, playerPos, forceNow)
        if not grid then return false, false end
        local now = tick()
        if now < fieldBlackoutUntil then return fieldUsableNow(grid, bcx, bcz), false end
        local minInt = forceNow and 0.06 or CONFIG.NAV_FIELD_MIN_INTERVAL
        if grid.dist and (now - fieldLastCompute) < minInt then
            return fieldUsableNow(grid, bcx, bcz), false
        end

        local acx, acz = navCellFromWorld(aimPos.X, aimPos.Z)
        local aimIdx = navIdx(grid, acx, acz)
        if not aimIdx or not grid.walk[aimIdx] then aimIdx = navNearestWalkable(grid, acx, acz, 3) end
        local pcx2, pcz2 = navCellFromWorld(playerPos.X, playerPos.Z)
        local plyIdx = navIdx(grid, pcx2, pcz2)
        if not plyIdx or not grid.walk[plyIdx] then plyIdx = navNearestWalkable(grid, pcx2, pcz2, 4) end

        local seeds = {}
        if aimIdx then seeds[#seeds + 1] = aimIdx end
        if plyIdx and plyIdx ~= aimIdx then seeds[#seeds + 1] = plyIdx end
        if #seeds == 0 then
            fieldBlackoutUntil = now + 0.3
            return false, false
        end

        local goalKey = table.concat(seeds, ",")
        local botKey = bcx .. "," .. bcz
        if not forceNow and grid.dist and not grid.fieldDirty
            and goalKey == fieldGoalKey and botKey == fieldBotKey
            and (now - fieldLastCompute) < CONFIG.NAV_FIELD_AGE then
            return fieldUsableNow(grid, bcx, bcz), false
        end

        local bIdx = navIdx(grid, bcx, bcz)
        fieldLastCompute = now
        fieldGoalKey = goalKey
        fieldBotKey = botKey
        grid.fieldDirty = false
        local ok = navComputeField(grid, seeds, bIdx)
        if not ok then fieldBlackoutUntil = now + 0.25 end
        return ok, true
    end
    
    RunService.Heartbeat:Connect(function(dt)
        local billboard = bot and bot:FindFirstChild("BillboardGui")
        local statsLabel = billboard and billboard:FindFirstChild("StatsLabel")
        
        -- [[ FREEZE LOGIC ]]
        if IS_FROZEN then
            if botRoot then
                botHum:MoveTo(botRoot.Position)
                botAlign.CFrame = botRoot.CFrame
            end
            if statsLabel then 
                statsLabel.Text = "SYSTEM FROZEN"
                statsLabel.TextColor3 = Color3.new(0, 1, 1)
            end
            return
        end

        if not player or not player.Parent then
            local newPlayers = Players:GetPlayers()
            if #newPlayers > 0 then
                player = newPlayers[1]
            else
                return
            end
        end
        
        if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
            return
        end
        
        targetRoot = player.Character.HumanoidRootPart
        local targetHum = player.Character:FindFirstChild("Humanoid")
        if not targetHum or targetHum.Health <= 0 then return end
        if not botRoot or not botRoot.Parent then return end
        
        local ignoreList = {bot, player.Character}
        
        -- [[ AIRBORNE FLAG - velocity + state, computed once per frame ]]
        local playerAirborne = isAirborne(targetRoot)

        -- [[ CLIMBING FLAG - while the bot's own Humanoid is climbing a
        -- ladder/truss, the ballistic jump / meet-jump / stuck-unstuck
        -- systems must stay out of the way: firing Jump or an unstuck
        -- impulse mid-climb yanks the bot off the ladder. ]]
        local botClimbing = botHum:GetState() == Enum.HumanoidStateType.Climbing
        
        -- [[ GEOMETRY: flat distance + vertical offset (used by kill + meet-jump) ]]
        local killVec = targetRoot.Position - botRoot.Position
        local flatDistMag = (killVec * Vector3.new(1, 0, 1)).Magnitude
        local yDiff = killVec.Y
        local dist = killVec.Magnitude
        
        -- [[ NAV GRID ]]
        navMaybeStartBuild(botRoot.Position, targetRoot.Position, ignoreList)
        navPumpQueues()
        
        local botCx, botCz = navCellFromWorld(botRoot.Position.X, botRoot.Position.Z)
        local tgtCx, tgtCz = navCellFromWorld(targetRoot.Position.X, targetRoot.Position.Z)
        local grid = Nav.active
        local gridUsable = false
        if grid then
            gridUsable = navGridContains(grid, botCx, botCz, Nav.EDGE_MARGIN)
                and navGridContains(grid, tgtCx, tgtCz, Nav.EDGE_MARGIN)
                and (tick() - grid.stamp) < Nav.FORCE_AGE * 1.5

            RAY_PARAMS.FilterDescendantsInstances = ignoreList
            if navRollingVerify(grid, CONFIG.NAV_VERIFY_PER_FRAME, RAY_PARAMS) then
                forceRepath = true
            end

            heatDecayTimer += dt
            if heatDecayTimer > 0.5 and grid.heat then
                heatDecayTimer = 0
                local h = grid.heat
                for i = 1, #h do
                    local v = h[i]
                    if v > 0.01 then h[i] = v * CONFIG.NAV_HEAT_DECAY else h[i] = 0 end
                end
            end
        end
        
        -- [[ SPEED MATH ]]
        local matMultiplier = analyseTerrainAndObstacles(botRoot, ignoreList)
        local difficultyMultiplier = math.min(CONFIG.DIFFICULTY_MAX_MULTIPLIER, 1 + (SCORE * CONFIG.DIFFICULTY_SCALE_KILLS))
        local closeBoost = (dist < 20) and CONFIG.CHASE_ACCEL_CLOSE or 1
        local botSpeed = CONFIG.CONSTANT_SPEED * matMultiplier * difficultyMultiplier * closeBoost
        botHum.WalkSpeed = botSpeed
        
        -- [[ DISTANCE-BASED AUDIO ]]
        local chaseSound = botRoot:FindFirstChild("ChaseMusic")
        if chaseSound then
            local volumeScale = math.clamp(1 - (dist / CONFIG.CHASE_AUDIO_RANGE), 0, 1)
            chaseSound.Volume = CONFIG.CHASE_VOLUME_MIN + (CONFIG.CHASE_VOLUME_MAX - CONFIG.CHASE_VOLUME_MIN) * volumeScale
            chaseSound.PlaybackSpeed = 0.9 + (0.3 * (1 - math.clamp(dist / 50, 0, 1)))
        end
        
        -- ====================================================================
        -- [[ KILL CHECK - FULL-BODY KILL VOLUME, SWEPT FOR RELIABILITY ]]
        -- Root-to-root under KILL_DIST, OR within the head's actual footprint:
        -- ~4.5 studs horizontally and anywhere from -6 to +10.5 vertically.
        -- Landing on the head, passing over it, or brushing it = contact = kill.
        -- The check is swept across this frame's bot movement (previous root
        -- position -> current root position) so a fast bot can't tunnel over
        -- a player standing directly underneath without ever landing on an
        -- exact instant that satisfies the test.
        -- ====================================================================
        local killHit = sweepKillVolume(lastKillSweepPos, botRoot.Position, targetRoot.Position)
        lastKillSweepPos = botRoot.Position
        if killHit then
            local s = botRoot:FindFirstChild("Scream"); if s then s:Play() end
            triggerRagdoll(player.Character)
            targetHum.Health = 0
            
            SCORE = SCORE + 1
            resetJukeMemory()
            mlResetEpisodeState()
            
            if statsLabel then
                statsLabel.Text = "KILLS: " .. SCORE
                statsLabel.TextColor3 = Color3.new(1, 0, 0) 
                task.delay(0.5, function()
                    if not IS_FROZEN and statsLabel then statsLabel.TextColor3 = Color3.new(1, 0.2, 0.2) end
                end)
            end
        end
        
        -- [[ BALLISTIC JUMP ENGINE ]]
        local moveVel = botRoot.AssemblyLinearVelocity
        local flatVel = moveVel * Vector3.new(1,0,1)
        local jumpReason = nil
        if not botClimbing and flatVel.Magnitude >= CONFIG.JUMP_MIN_SPEED
            and tick() - JumpState.lastJump > CONFIG.JUMP_COOLDOWN then
            local jumpOK
            jumpOK, jumpReason = evaluateJump(botRoot, flatVel, ignoreList)
            if jumpOK then
                botHum.Jump = true
                JumpState.lastJump = tick()
            end
        end
        if jumpReason == "TOO_TALL" and grid then
            grid.fieldDirty = true
        end

        -- Anti-ceiling pushdown (only ever REDUCES height)
        if flatVel.Magnitude > 8 then
            RAY_PARAMS.FilterDescendantsInstances = ignoreList
            local headRay = workspace:Raycast(botRoot.Position + Vector3.new(0, 2, 0), flatVel.Unit * 4, RAY_PARAMS)
            if headRay then
                local kneeCheck = workspace:Raycast(botRoot.Position - Vector3.new(0, 2, 0), flatVel.Unit * 4, RAY_PARAMS)
                if not kneeCheck then
                    botRoot.AssemblyLinearVelocity = botRoot.AssemblyLinearVelocity + Vector3.new(0, -5, 0)
                end
            end
        end

        -- ====================================================================
        -- [[ MEET-THEM JUMP v2 - FLAT proximity based ]]
        -- The old 3D-distance gate meant the vertical gap itself disabled the
        -- counter-jump exactly when it was needed. Now: within 7 studs FLAT and
        -- they're above us and descending (or hanging near apex) -> jump to meet.
        -- ====================================================================
        local targetVy = targetRoot.AssemblyLinearVelocity.Y
        if not botClimbing and yDiff > CONFIG.MEET_JUMP_Y_DIFF and flatDistMag < CONFIG.MEET_JUMP_FLAT then
            if targetVy < CONFIG.MEET_JUMP_DESCENT
                or (math.abs(targetVy) < CONFIG.MEET_JUMP_APEX_VY and yDiff < CONFIG.MEET_JUMP_APEX_Y) then
                botHum.Jump = true
            end
        end
        
        -- [[ STUCK MONITOR - PURE PHYSICS + heat memory ]]
        if tick() - lastStuckCheck > 0.2 then
            if botClimbing then
                -- Climbing is naturally slow/vertical - don't mistake it for
                -- being stuck and launch an unstuck burst mid-ladder.
                stuckCount = 0
                lastStuckPos = botRoot.Position; lastStuckCheck = tick()
            else
                local moved = (botRoot.Position - lastStuckPos).Magnitude
                if moved < 0.8 then
                    stuckCount += 1
                    botHum.Jump = true
                    if grid then bumpHeat(grid, botCx, botCz, CONFIG.NAV_HEAT_BUMP_STUCK) end

                    local toPlayer = (targetRoot.Position - botRoot.Position) * Vector3.new(1, 0, 1)
                    if toPlayer.Magnitude > 1 then toPlayer = toPlayer.Unit else toPlayer = botRoot.CFrame.LookVector * Vector3.new(1,0,1) end

                    local escapeDir = findEscapeDirection(botRoot.Position, toPlayer, ignoreList)
                    local perp = Vector3.new(-escapeDir.Z, 0, escapeDir.X)

                    if stuckCount <= CONFIG.UNSTUCK_BURST_THRESHOLD then
                        botRoot.AssemblyLinearVelocity = botRoot.AssemblyLinearVelocity
                            + Vector3.new(0, CONFIG.UNSTUCK_VELOCITY_UP, 0)
                            + escapeDir * CONFIG.UNSTUCK_VELOCITY_FORWARD
                    else
                        botRoot.AssemblyLinearVelocity = Vector3.zero
                        botRoot.AssemblyLinearVelocity = (escapeDir * CONFIG.UNSTUCK_HEAVY_FORWARD)
                            + (perp * (stuckCount % 2 == 0 and CONFIG.UNSTUCK_HEAVY_SIDE or -CONFIG.UNSTUCK_HEAVY_SIDE))
                            + Vector3.new(0, CONFIG.UNSTUCK_HEAVY_UP, 0)
                    end
                    forceRepath = true
                else
                    stuckCount = 0
                    if waypoints then
                        local expected = math.max(botHum.WalkSpeed * 0.2, 8)
                        if moved < expected * CONFIG.PARTIAL_STUCK_RATIO then
                            forceRepath = true
                            if grid then bumpHeat(grid, botCx, botCz, CONFIG.NAV_HEAT_BUMP_PARTIAL) end
                        end
                    end
                end
                lastStuckPos = botRoot.Position; lastStuckCheck = tick()
            end
        end

        -- [[ UNJUKEABLE PREDICTION - every frame (LAYER 0 = true landing) ]]
        local aimPos, moveName = calculateUnjukeableMove(botRoot, targetRoot, botSpeed, ignoreList, dt)

        -- [[ ZERO-REACTION RE-ROUTE ]] the frame a juke is read (from the
        -- player's INPUT, not their velocity) the flow field and fallback
        -- path are both invalidated, so the very next steering decision is
        -- already built around the new heading.
        if JukeState.jukeEvent then
            JukeState.jukeEvent = false
            forceRepath = true
            if grid then grid.fieldDirty = true end
        end

        -- [[ LINK LEARNING ]] grade the jump we're currently in the middle of
        linkLearnUpdate(botRoot.Position, grid, stuckCount > 0)

        -- [[ TURN ASSIST - skipped mid-air ]]
        local now = tick()
        local botFlatVel = botRoot.AssemblyLinearVelocity * Vector3.new(1, 0, 1)
        if aimPos and botFlatVel.Magnitude > CONFIG.TURN_BRAKE_MIN_SPEED
            and now > turnBrakeCooldown
            and math.abs(botRoot.AssemblyLinearVelocity.Y) < 8 then
            local desired = (aimPos - botRoot.Position) * Vector3.new(1, 0, 1)
            if desired.Magnitude > 1 and botFlatVel.Unit:Dot(desired.Unit) < CONFIG.TURN_BRAKE_DOT then
                turnBrakeCooldown = now + CONFIG.TURN_BRAKE_COOLDOWN
                local v = botRoot.AssemblyLinearVelocity
                botRoot.AssemblyLinearVelocity = Vector3.new(botFlatVel.X * CONFIG.TURN_BRAKE_STRENGTH, v.Y, botFlatVel.Z * CONFIG.TURN_BRAKE_STRENGTH)
            end
        end
        
        -- [[ LOS CHECKS - every frame ]]
        local canSeeAim = aimPos and hasClearLineOfSight(botRoot.Position, aimPos, ignoreList) or false
        local canSeePlayer = hasClearLineOfSight(botRoot.Position, targetRoot.Position, ignoreList)

        local faceTarget = targetRoot.Position

        if canSeeAim and aimPos then
            waypoints = nil
            pathSource = nil
            
            -- ================================================================
            -- [[ GUARD HOLD: already parked on the landing zone ]]
            -- Player airborne + we're on their touchdown spot: STOP moving and
            -- let them land ON us. The head span IS the kill zone, and the
            -- meet-jump below rises into them if they're still high up.
            -- ================================================================
            if playerAirborne and AirState.active and AirState.tLand > 0.08 then
                local toLanding = (AirState.landing - botRoot.Position) * Vector3.new(1, 0, 1)
                local holdThreshold = guardHoldActive
                    and (CONFIG.GUARD_HOLD_RADIUS + CONFIG.GUARD_HOLD_HYSTERESIS)
                    or CONFIG.GUARD_HOLD_RADIUS
                if toLanding.Magnitude <= holdThreshold then
                    guardHoldActive = true
                    botHum:MoveTo(botRoot.Position)
                    faceTarget = targetRoot.Position -- eyes up, watching them fall
                    if statsLabel and statsLabel.TextColor3 ~= Color3.new(1, 0, 0) then
                        statsLabel.Text = "KILLS: " .. SCORE .. " [GUARD]"
                    end
                else
                    guardHoldActive = false
                    local movePos = steerAroundObstacle(botRoot.Position, aimPos, ignoreList, wallSteerState)
                    botHum:MoveTo(movePos)
                    faceTarget = aimPos
                    if statsLabel and statsLabel.TextColor3 ~= Color3.new(1, 0, 0) then
                        statsLabel.Text = "KILLS: " .. SCORE .. " [" .. moveName .. "]"
                    end
                end
            else
                guardHoldActive = false
                local movePos = steerAroundObstacle(botRoot.Position, aimPos, ignoreList, wallSteerState)
                botHum:MoveTo(movePos)
                faceTarget = aimPos
                if statsLabel and statsLabel.TextColor3 ~= Color3.new(1, 0, 0) then
                    statsLabel.Text = "KILLS: " .. SCORE .. " [" .. moveName .. "]"
                end
            end
        elseif canSeePlayer and not playerAirborne then
            -- NOTE: locked out while the player is airborne. MoveTo flattens
            -- their airborne position to the ground - chasing the flattened
            -- shadow is EXACTLY what made the bot slide under jumpers.
            waypoints = nil
            pathSource = nil
            local movePos = steerAroundObstacle(botRoot.Position, targetRoot.Position, ignoreList, wallSteerState)
            botHum:MoveTo(movePos)
            faceTarget = targetRoot.Position
            if statsLabel and statsLabel.TextColor3 ~= Color3.new(1, 0, 0) then
                statsLabel.Text = "KILLS: " .. SCORE .. " [DIRECT]"
            end
        else
            -- No LOS (or the player is airborne and the landing spot is
            -- obstructed): navigate to the AIM (the landing point), never the
            -- airborne shadow.
            if statsLabel and statsLabel.TextColor3 ~= Color3.new(1, 0, 0) then
                statsLabel.Text = "KILLS: " .. SCORE .. (pathSource == "nav" and " [NAV]" or "")
            end

            -- ZERO-IDLE
            if (isComputing or Nav.pending) and aimPos then
                botHum:MoveTo(aimPos)
                faceTarget = aimPos
            end

            if waypoints and aimPos then
                local lastWp = waypoints[#waypoints]
                if lastWp and ((lastWp.Position - aimPos) * Vector3.new(1, 0, 1)).Magnitude > CONFIG.AIM_DRIFT_REPATH then
                    forceRepath = true
                end
            end

            -- [[ POCKET AMBUSH ]]
            if gridUsable and tick() > ambushSuppressUntil then
                pocketTimer += dt
                if pocketTimer >= CONFIG.POCKET_INTERVAL then
                    pocketTimer = 0
                    local botIdx = navIdx(grid, botCx, botCz)
                    local exits = navAnalyzePocket(grid, targetRoot.Position, botIdx, CONFIG.POCKET_DEPTH, CONFIG.POCKET_CAP)
                    local chosen = nil
                    if exits then
                        local bestScore = -math.huge
                        for _, e in ipairs(exits) do
                            local pDist = ((e.pos - targetRoot.Position) * Vector3.new(1,0,1)).Magnitude
                            local bDist = ((e.pos - botRoot.Position) * Vector3.new(1,0,1)).Magnitude
                            local score = pDist - bDist
                            if score > bestScore then
                                bestScore = score
                                chosen = e
                            end
                        end
                        if #exits > 1 and bestScore < CONFIG.POCKET_RACE_MARGIN then
                            chosen = nil
                        end
                    end
                    if chosen then
                        if ambush.cellIdx == chosen.idx then
                            ambush.untilT = tick() + CONFIG.POCKET_INTERVAL * 2.5
                        else
                            ambush.cellIdx = chosen.idx
                            ambush.target = chosen.pos
                            ambush.firstSeen = tick()
                            ambush.untilT = tick() + CONFIG.POCKET_INTERVAL * 2.5
                        end
                    else
                        ambush.target = nil
                        ambush.cellIdx = nil
                    end
                end
            end
            
            local ambushActive = false
            if ambush.target then
                if tick() > ambush.untilT then
                    ambush.target = nil
                    ambush.cellIdx = nil
                elseif (tick() - ambush.firstSeen) > CONFIG.AMBUSH_PUSH_AFTER then
                    ambush.target = nil
                    ambush.cellIdx = nil
                    ambushSuppressUntil = tick() + CONFIG.AMBUSH_PUSH_COOLDOWN
                else
                    ambushActive = true
                end
            end
            
            if ambushActive then
                waypoints = nil
                pathSource = nil
                local toExit = (ambush.target - botRoot.Position) * Vector3.new(1, 0, 1)
                if toExit.Magnitude < 5 then
                    botHum:MoveTo(botRoot.Position)
                    faceTarget = targetRoot.Position
                else
                    local traveled = false
                    if gridUsable then
                        local ok = ensureField(grid, botCx, botCz, ambush.target, ambush.target, forceRepath or grid.fieldDirty)
                        if ok then
                            local steer = fieldSteer(botRoot, grid, fieldSteerState)
                            if steer == "GOAL" then
                                botHum:MoveTo(ambush.target)
                                faceTarget = ambush.target
                                traveled = true
                            elseif steer then
                                botHum:MoveTo(steer)
                                faceTarget = steer
                                traveled = true
                            end
                        end
                    end
                    if not traveled then
                        botHum:MoveTo(ambush.target)
                        faceTarget = ambush.target
                    end
                end
                forceRepath = false
                if statsLabel and statsLabel.TextColor3 ~= Color3.new(1, 0, 0) then
                    statsLabel.Text = "KILLS: " .. SCORE .. " [AMBUSH]"
                end
            else
                -- [[ FLOW FIELD STEERING ]]
                local fieldOK = false
                local fieldFresh = false
                if gridUsable then
                    local aimForField = aimPos or targetRoot.Position
                    fieldOK, fieldFresh = ensureField(grid, botCx, botCz, aimForField, targetRoot.Position, forceRepath or grid.fieldDirty)
                    if fieldOK then
                        local steer, dir, wantJump, wantClimb, gapLink = fieldSteer(botRoot, grid, fieldSteerState)
                        if steer == "GOAL" then
                            waypoints = nil
                            pathSource = nil
                            botHum:MoveTo(aimForField)
                            faceTarget = aimForField
                        elseif steer then
                            waypoints = nil
                            pathSource = nil
                            botHum:MoveTo(steer)
                            faceTarget = steer
                            if gapLink then
                                -- [[ GAP LINK ]] sprint straight at the landing and
                                -- leave the ground the instant the floor ends. A
                                -- normal jump, from the true edge = maximum range.
                                if not botClimbing and LinkMemory.attempt == nil
                                    and tick() - JumpState.lastJump > CONFIG.JUMP_COOLDOWN
                                    and gapEdgeAhead(botRoot, dir, ignoreList) then
                                    botHum.Jump = true
                                    JumpState.lastJump = tick()
                                    linkLearnBegin(gapLink.key, gapLink.landing)
                                end
                                if statsLabel and statsLabel.TextColor3 ~= Color3.new(1, 0, 0) then
                                    statsLabel.Text = "KILLS: " .. SCORE .. " [LEAP]"
                                end
                            elseif wantJump and not wantClimb and tick() - JumpState.lastJump > CONFIG.JUMP_COOLDOWN then
                                local synthVel = (dir or (steer - botRoot.Position) * Vector3.new(1, 0, 1).Unit)
                                    * math.max(flatVel.Magnitude, 14)
                                local ok, why = evaluateJump(botRoot, synthVel, ignoreList)
                                if ok then
                                    botHum.Jump = true
                                    JumpState.lastJump = tick()
                                elseif why == "TOO_TALL" then
                                    grid.fieldDirty = true
                                end
                            end
                        else
                            fieldOK = false
                        end
                    end
                    if fieldOK then
                        forceRepath = false
                        if fieldFresh and CONFIG.SHOW_WAYPOINTS then
                            visualizeFieldDescent(botRoot, grid)
                        end
                        if statsLabel and statsLabel.TextColor3 ~= Color3.new(1, 0, 0) then
                            statsLabel.Text = "KILLS: " .. SCORE .. (LinkMemory.attempt and " [LEAP]" or " [FIELD]")
                        end
                    end
                end
                
                -- [[ ROBLOX FALLBACK ]]
                if not fieldOK then
                    if (isComputing or Nav.pending) and aimPos then
                        botHum:MoveTo(aimPos)
                        faceTarget = aimPos
                    end

                    local targetMoved = (targetRoot.Position - lastTargetPos).Magnitude > 3
                    local aimMoved = false
                    if aimPos and lastPathAim then
                        aimMoved = (aimPos - lastPathAim).Magnitude > CONFIG.AIM_DRIFT_REPATH
                    end

                    local baseRefresh = dist < 30 and CONFIG.PATH_REFRESH_CLOSE or CONFIG.PATH_REFRESH_FAR
                    local refreshRate = baseRefresh * (1 - math.min(JukeState.jukeCount, 5) * 0.12)
                    local pathExpired = (tick() - lastPathTime > refreshRate)

                    if (targetMoved or aimMoved or pathExpired or forceRepath or waypoints == nil) and not isComputing then
                        isComputing = true; forceRepath = false
                        lastPathTime = tick(); lastTargetPos = targetRoot.Position
                        
                        local pathTarget = aimPos or targetRoot.Position
                        lastPathAim = pathTarget
                        
                        local startBase = botRoot.Position
                        local aimForPath = pathTarget
                        local playerRootNow = targetRoot
                        local computeIgnore = ignoreList
                        
                        task.spawn(function()
                            local startGround = snapToGround(startBase, computeIgnore)
                            local targetGround = snapToGround(aimForPath, computeIgnore)
                            local success = pcall(function() path:ComputeAsync(startGround, targetGround) end)
                            if success and path.Status == Enum.PathStatus.Success then
                                local newPoints = path:GetWaypoints()
                                if #newPoints > 0 then
                                    waypoints = newPoints; currentPointIndex = 2; pathSource = "roblox"
                                    lastPathAim = newPoints[#newPoints].Position
                                    visualizeWaypoints(newPoints)
                                end
                            elseif success then
                                local retryGround = snapToGround(playerRootNow.Position, computeIgnore)
                                local ok2 = pcall(function() path:ComputeAsync(startGround, retryGround) end)
                                if ok2 and path.Status == Enum.PathStatus.Success then
                                    local newPoints = path:GetWaypoints()
                                    if #newPoints > 0 then
                                        waypoints = newPoints; currentPointIndex = 2; pathSource = "roblox"
                                        lastPathAim = newPoints[#newPoints].Position
                                        visualizeWaypoints(newPoints)
                                    end
                                else
                                    botHum:MoveTo(playerRootNow.Position)
                                end
                            else
                                botHum:MoveTo(playerRootNow.Position)
                            end
                            isComputing = false
                        end)
                    end

                    if waypoints and currentPointIndex <= #waypoints then
                        currentPointIndex = optimizePath(currentPointIndex, waypoints, botRoot.Position, ignoreList)
                        local targetPoint = waypoints[currentPointIndex]
                        if targetPoint then
                            botHum:MoveTo(targetPoint.Position)
                            faceTarget = targetPoint.Position

                            local nextPoint = waypoints[currentPointIndex + 1]
                            local jumpPoint = (targetPoint.Action == Enum.PathWaypointAction.Jump) and targetPoint
                                or (nextPoint and nextPoint.Action == Enum.PathWaypointAction.Jump and nextPoint) or nil
                            if jumpPoint then
                                local flatDist2 = ((jumpPoint.Position - botRoot.Position) * Vector3.new(1, 0, 1)).Magnitude
                                local earlyDist = CONFIG.EARLY_JUMP_BASE + flatVel.Magnitude * CONFIG.EARLY_JUMP_LEAD
                                if flatDist2 <= earlyDist then
                                    if jumpLinkStillClear(botRoot, jumpPoint, ignoreList) then
                                        botHum.Jump = true
                                        JumpState.lastJump = tick()
                                    else
                                        forceRepath = true
                                    end
                                end
                            end
                            
                            local vecToPoint = (targetPoint.Position - botRoot.Position) * Vector3.new(1,0,1)
                            local currentSpeed = botRoot.AssemblyLinearVelocity.Magnitude
                            local baseRadius = dist < 25 and 1.2 or 1.8
                            local arrivalRadius = math.clamp(currentSpeed * 0.06, baseRadius, 5) 
                            
                            local arrived = vecToPoint.Magnitude < arrivalRadius and math.abs(targetPoint.Position.Y - botRoot.Position.Y) < 10

                            local passed = false
                            if not arrived and flatVel.Magnitude > 10 and vecToPoint.Magnitude > 0.1 then
                                local passRadius = math.clamp(flatVel.Magnitude * 0.22, CONFIG.WAYPOINT_PASS_MIN, CONFIG.WAYPOINT_PASS_MAX)
                                if vecToPoint.Magnitude < passRadius and vecToPoint.Unit:Dot(flatVel.Unit) < CONFIG.WAYPOINT_PASS_DOT then
                                    passed = true
                                end
                            end

                            if arrived or passed then
                                currentPointIndex = currentPointIndex + 1
                            end
                        end
                    end
                end
            end
        end

        -- ====================================================================
        -- [[ SMOOTH FACING - clamped turn-rate, no more snap/shake ]]
        -- Previously this set botAlign.CFrame straight to a fresh lookAt
        -- every Heartbeat: any small back-and-forth in faceTarget (steering
        -- deciding between two close options) showed up as a visible
        -- left-right head shake. Now the yaw is turned toward the target at
        -- a clamped rate, so a flickering target just gets smoothly chased
        -- instead of snapped to.
        -- ====================================================================
        local faceFlat = (faceTarget - botRoot.Position) * Vector3.new(1, 0, 1)
        if faceFlat.Magnitude > CONFIG.FACE_SNAP_DIST then
            local desiredYaw = math.atan2(faceFlat.X, faceFlat.Z)
            local diff = (desiredYaw - faceYaw + math.pi) % (2 * math.pi) - math.pi
            local maxStep = math.rad(CONFIG.FACE_TURN_RATE_DEG) * dt
            diff = math.clamp(diff, -maxStep, maxStep)
            faceYaw = faceYaw + diff
            local dir = Vector3.new(math.sin(faceYaw), 0, math.cos(faceYaw))
            botAlign.CFrame = CFrame.lookAt(botRoot.Position, botRoot.Position + dir)
        end
    end)
end)

-- ========================================================================
-- [[ 7. CLIENT-SIDE SPAWN TOOL ]]
-- This script still runs server-side first, so the block below seeds the
-- "Spawn Tool" LocalScript into StarterPlayerScripts for every player (both
-- current and future) and hooks the server half of the spawn remote. The
-- seeded LocalScript is the actual tool: it activates when the game starts,
-- shows the "SPAWN TOOL ACTIVE" UI, drops a red neon marker where the player
-- left-clicks, raycasts down to the ground, then asks the server (through
-- spawnRemote) to spawn the nextbot there.
-- ========================================================================
local SPAWN_TOOL_SOURCE = [==[
-- [[ NEXTBOT SPAWN TOOL (client) - generated by the Main script ]]
-- Left-click anywhere in the world to move the nextbot to that spot.

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local mouse = player:GetMouse()
local spawnRemote = ReplicatedStorage:WaitForChild("SpawnNextbotRemote")

local SPAWN_HEIGHT_OFFSET = 5   -- how far above the ground the bot spawns

local spawnToolActive = false
local spawnMarker = nil
local statusLabel = nil

-- Red neon sphere marking the clicked spawn location.
local function createSpawnMarker(position)
    if spawnMarker then
        spawnMarker:Destroy()
    end

    spawnMarker = Instance.new("Part")
    spawnMarker.Name = "SpawnMarker"
    spawnMarker.Shape = Enum.PartType.Ball
    spawnMarker.Size = Vector3.new(2, 2, 2)
    spawnMarker.BrickColor = BrickColor.new("Bright red")
    spawnMarker.Material = Enum.Material.Neon
    spawnMarker.Anchored = true
    spawnMarker.CanCollide = false
    spawnMarker.CFrame = CFrame.new(position)
    spawnMarker.Parent = workspace

    local light = Instance.new("PointLight")
    light.Brightness = 2
    light.Range = 20
    light.Color = Color3.fromRGB(255, 0, 0)
    light.Parent = spawnMarker

    return spawnMarker
end

local function clearSpawnMarker()
    if spawnMarker then
        spawnMarker:Destroy()
        spawnMarker = nil
    end
end

-- "SPAWN TOOL ACTIVE" indicator at the top of the screen.
local function createSpawnToolGui()
    local playerGui = player:WaitForChild("PlayerGui")
    local screenGui = playerGui:FindFirstChild("SpawnToolGui")
    if not screenGui then
        screenGui = Instance.new("ScreenGui")
        screenGui.Name = "SpawnToolGui"
        screenGui.ResetOnSpawn = false
        screenGui.Parent = playerGui

        local textLabel = Instance.new("TextLabel")
        textLabel.Name = "SpawnToolLabel"
        textLabel.Size = UDim2.new(0, 300, 0, 60)
        textLabel.Position = UDim2.new(0.5, -150, 0, 20)
        textLabel.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        textLabel.BackgroundTransparency = 0.5
        textLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
        textLabel.TextSize = 16
        textLabel.Font = Enum.Font.GothamBold
        textLabel.Text = "SPAWN TOOL ACTIVE\nClick to spawn nextbot"
        textLabel.Parent = screenGui

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 8)
        corner.Parent = textLabel
    end
    return screenGui.SpawnToolLabel
end

-- Left-click: mark the spot, find the ground, ask the server to spawn there.
local function onSpawnToolClick()
    if not spawnToolActive then
        return
    end

    local targetPosition = mouse.Hit and mouse.Hit.Position
    if not targetPosition then
        return
    end

    local marker = createSpawnMarker(targetPosition)

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = {player.Character, marker}
    rayParams.IgnoreWater = false

    local spawnY = targetPosition.Y + SPAWN_HEIGHT_OFFSET
    local rayResult = workspace:Raycast(targetPosition + Vector3.new(0, 50, 0), Vector3.new(0, -150, 0), rayParams)
    if rayResult then
        spawnY = rayResult.Position.Y + SPAWN_HEIGHT_OFFSET
    end

    local finalSpawnPos = Vector3.new(targetPosition.X, spawnY, targetPosition.Z)
    spawnRemote:FireServer(finalSpawnPos)
    print("[SpawnTool] NextBot spawn requested at:", finalSpawnPos)

    if statusLabel then
        statusLabel.Text = "SPAWN TOOL ACTIVE\nNextbot spawned!"
        task.delay(2, function()
            if statusLabel then
                statusLabel.Text = "SPAWN TOOL ACTIVE\nClick to spawn nextbot"
            end
        end)
    end

    Debris:AddItem(marker, 3)
    spawnMarker = nil
end

-- The tool is armed as soon as the game starts.
local function activateSpawnTool()
    if spawnToolActive then
        return
    end
    spawnToolActive = true
    statusLabel = createSpawnToolGui()
    mouse.Icon = "rbxasset://textures/Cursors/MouseLockedCursor.png"
    print("[SpawnTool] Spawn tool activated - click to spawn nextbot!")
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then
        return
    end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        onSpawnToolClick()
    end
end)

-- Re-arm the tool after a respawn so it stays usable for the whole session.
player.CharacterAdded:Connect(function()
    clearSpawnMarker()
    task.wait(0.5)
    activateSpawnTool()
end)

activateSpawnTool()
print("[SpawnTool] Loaded - NextBot spawn tool ready!")
]==]

local function seedSpawnTool(player)
    local ok, err = pcall(function()
        local starterPlayerScripts = player:WaitForChild("StarterPlayerScripts", 10)
        if starterPlayerScripts and not starterPlayerScripts:FindFirstChild("SpawnTool") then
            local toolScript = Instance.new("LocalScript")
            toolScript.Name = "SpawnTool"
            toolScript.Source = SPAWN_TOOL_SOURCE
            toolScript.Parent = starterPlayerScripts
        end
    end)
    if not ok then
        warn("[SpawnTool] Failed to seed spawn tool for " .. player.Name .. ": " .. tostring(err))
    end
end

for _, p in ipairs(Players:GetPlayers()) do
    task.spawn(seedSpawnTool, p)
end
Players.PlayerAdded:Connect(function(p)
    task.spawn(seedSpawnTool, p)
end)

-- Server half of the tool: the bot already exists by the time the player can
-- see and click, so spawnRemote (created above) can simply move it.
spawnRemote.OnServerEvent:Connect(function(player, spawnPosition)
    if typeof(spawnPosition) ~= "Vector3" then
        return
    end
    local botModel = workspace:FindFirstChild("Nextbot_V25_OverheadKill")
    local botRootPart = botModel and botModel:FindFirstChild("HumanoidRootPart")
    if botRootPart then
        botModel:PivotTo(CFrame.new(spawnPosition))
        botRootPart.AssemblyLinearVelocity = Vector3.zero
        print("[SpawnTool] " .. player.Name .. " spawned the nextbot at " .. tostring(spawnPosition))
    end
end)
